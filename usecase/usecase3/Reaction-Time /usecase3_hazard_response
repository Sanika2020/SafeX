import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.metrics import accuracy_score, classification_report, mean_absolute_error
from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor

from google.colab import files
# ============================================
# 2. UPLOAD THE DATASET
# ============================================
print("Please upload your dataset (CSV file)...")
uploaded = files.upload()

# Automatically get the uploaded filename
filename = list(uploaded.keys())[0]

df = pd.read_csv(filename)
print("\nDataset Uploaded & Loaded Successfully!")
print(df.head())
print(df.shape)

# ============================================
# 3. ENCODE TARGET LABEL (reaction_type)
# ============================================
label_encoder = LabelEncoder()
df["reaction_type_encoded"] = label_encoder.fit_transform(df["reaction_type"])

print("\nLabel Encoding Mapping:")
for cls, enc in zip(label_encoder.classes_, label_encoder.transform(label_encoder.classes_)):
    print(f"{cls} → {enc}")

# ============================================
# 4. FEATURE SELECTION
# ============================================
X = df[["reaction_time", "hazard_complexity", "driver_fatigue", "distraction_level"]]

y_class = df["reaction_type_encoded"]      # Classification target
y_reg = df["reaction_latency"]             # Regression target

# ============================================
# 5. TRAIN–TEST SPLIT
# ============================================
X_train, X_test, y_class_train, y_class_test = train_test_split(
    X, y_class, test_size=0.2, random_state=42
)

_, _, y_reg_train, y_reg_test = train_test_split(
    X, y_reg, test_size=0.2, random_state=42
)

print("\nData Split Completed!")
print("Training size:", X_train.shape)
print("Testing size:", X_test.shape)

# ============================================
# 6. SCALE FEATURES
# ============================================
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# ============================================
# 7. TRAIN CLASSIFICATION MODEL (reaction type)
# ============================================
clf = RandomForestClassifier(n_estimators=300, random_state=42)
clf.fit(X_train_scaled, y_class_train)

# Predictions
y_class_pred = clf.predict(X_test_scaled)

# Accuracy
class_accuracy = accuracy_score(y_class_test, y_class_pred)
print("\n========================================")
print(" REACTION TYPE CLASSIFICATION RESULTS")
print("========================================")
print("Accuracy:", class_accuracy)
print("\nClassification Report:")
print(classification_report(y_class_test, y_class_pred, target_names=label_encoder.classes_))

# ============================================
# 8. TRAIN REGRESSION MODEL (reaction latency)
# ============================================
reg = RandomForestRegressor(n_estimators=300, random_state=42)
reg.fit(X_train_scaled, y_reg_train)

y_reg_pred = reg.predict(X_test_scaled)
mae = mean_absolute_error(y_reg_test, y_reg_pred)

print("\n========================================")
print(" REACTION LATENCY REGRESSION RESULTS")
print("========================================")
print("Mean Absolute Error:", mae)

# ============================================
# 9. FINAL OUTPUT SAMPLE PREDICTION (LIKE YOUR IMAGE)
# ============================================
sample = np.array([[1.8, 5, 4, 4]])  # example input
sample_scaled = scaler.transform(sample)

pred_class = label_encoder.inverse_transform(clf.predict(sample_scaled))[0]
pred_latency = reg.predict(sample_scaled)[0]

print("\n========================================")
print("   FINAL OUTPUT (AS REQUIRED)")
print("========================================")
print("reaction_type        :", pred_class)
print("reaction_latency     :", round(pred_latency, 3), "seconds")
